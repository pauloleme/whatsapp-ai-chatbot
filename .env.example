
# ==============================================================================
# BOT WHATSAPP + IA  |  arquivo .env
# Preencha os campos marcados com COLE_AQUI. Nunca compartilhe este arquivo.
# ==============================================================================

# Provedor de IA ativo: gemini, openai ou claude
AI_PROVIDER=gemini

# Porta do servidor local
PORT=3000

# ------------------------------------------------------------------------------
# GOOGLE GEMINI (gratuito)
# Chave em: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# OPENAI (opcional, so se AI_PROVIDER=openai)
# Chave em: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# ANTHROPIC CLAUDE (opcional, so se AI_PROVIDER=claude)
# Chave em: https://console.anthropic.com/settings/keys
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ------------------------------------------------------------------------------
# WHATSAPP CLOUD API (Meta)
# ------------------------------------------------------------------------------
# Token de acesso: Casos de uso > WhatsApp > Configuracao da API
# (o temporario expira em cerca de 24h; gere outro quando der erro 401/190)

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Frase secreta qualquer. Use a MESMA no campo "Token de verificacao" do webhook na Meta
WHATSAPP_VERIFY_TOKEN=

# Chave secreta do app: Configuracoes do app > Basico > Chave secreta do app
META_APP_SECRET=

# Versao da Graph API da Meta
GRAPH_VERSION=v26.0

# ------------------------------------------------------------------------------
# PERSONALIZACAO DO BOT
# ------------------------------------------------------------------------------
SYSTEM_PROMPT="VocÃª Ã© um assistente prestativo no WhatsApp. Responda em portuguÃªs, de forma clara e curta."

# Quantidade de mensagens lembradas por contato
MAX_HISTORY=20
